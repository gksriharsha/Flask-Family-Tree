# Copy to .env and fill in.

# Required. Every endpoint can read, rewrite or delete family records, so the app refuses to
# start without this. Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
FAMILYTREE_API_TOKEN=

# Host port the API is published on. Change this if something already holds the default --
# on macOS the AirPlay Receiver listens on 5000 and will win the bind.
API_PORT=5000

# Comma-separated exact origins allowed to call the API from a browser.
CORS_ALLOWED_ORIGINS=http://localhost:4200

# The SQLite database file — the whole tree lives here. Back the tree up by copying this file
# (and its -wal/-shm siblings if present), or the FAMILYTREE_DATA_DIR folder as a whole.
# Defaults to <FAMILYTREE_DATA_DIR>/family.sqlite when unset.
FAMILYTREE_DB_PATH=./data/family.sqlite

# Uploads, media and the face store. Never inside the source tree.
FAMILYTREE_DATA_DIR=./data

LOG_LEVEL=INFO

# Coordinate lookup is off by default. Enable it only with a User-Agent that identifies this
# deployment and carries a contact address, as Nominatim's usage policy requires.
GEOCODING_ENABLED=0
# GEOCODING_USER_AGENT=family-tree/0.1 (you@example.com)
